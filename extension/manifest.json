{
  "manifest_version": 3,
  "name": "OGS → Ogatak",
  "version": "1.0.0",
  "description": "Download the SGF of the current online-go.com game/review and open it in Ogatak.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting"],
  "host_permissions": ["https://online-go.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open in Ogatak",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Open current OGS game in Ogatak"
    }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
